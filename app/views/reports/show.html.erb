<h1><%= t('views.common.title_show', name: Report.model_name.human) %></h1>

<div class="show-item">
  <%= render @report %>
</div>

<%= render 'shared/comments', commentable: @report %>

<nav class="page-nav">
  <% if @report.editable?(current_user) %>
    <%= link_to t('views.common.edit', name: Report.model_name.human.downcase), edit_report_path(@report) %> |
  <% end %>
</nav>

  <% if @report.mentioned_reports.exists? %>
    <div class="title">
      <%= t('reports.show.mention.mentioned_by') %>
    </div>
  <% end %>
  <% @report.mentioned_reports.order(:id).each_with_index do |report, index| %>
    <div class="flex-gap">
      <%= link_to report.user.name, user_path(report.user) %>
      <%= t('reports.show.mention.title') %>
      <%= link_to report.title, report_path(report.id) %>
      <%= t('reports.show.mention.mentioning') %>
    </div>
  <% end %>

<nav class="page-nav">
  <%= link_to t('views.common.back', name: i18n_pluralize(Report.model_name.human.downcase)), reports_path %>

  <% if @report.editable?(current_user) %>
    <%= button_to t('views.common.destroy', name: Report.model_name.human.downcase), @report, method: :delete %>
  <% end %>
</nav>
